{
  "manifest_version": 3,
  "name": "rancheck",
  "version": "0.5.0",
  "description": "Has this been run before? Counts prior deployments of the pair you are looking at on Axiom.",
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.axiom-cdn.io/*"
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
